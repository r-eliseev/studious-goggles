<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="Allure.NUnit" Version="2.15.0" />
    <PackageReference Include="Allure.Reqnroll" Version="2.15.0" />
  </ItemGroup>
  <ItemGroup>
    <ReqnrollFeatureFiles Include="../../../ImageGen/ImageGen.Acceptance.Tests/Features/FirstRunAndKeys.feature"
                          Link="Shared/FirstRunAndKeys.feature" />
  </ItemGroup>
</Project>
