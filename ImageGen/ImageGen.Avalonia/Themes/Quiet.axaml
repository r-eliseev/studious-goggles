      <SolidColorBrush x:Key="IgUserMessageBackgroundBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="IgPromptBackgroundBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="IgPromptForegroundBrush" Color="#9AA3AE" />
