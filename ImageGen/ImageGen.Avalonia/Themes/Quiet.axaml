      <Color x:Key="IgMutedColor">#9AA3AE</Color>
      <Color x:Key="IgLineColor">#2E343C</Color>
      <Color x:Key="IgControlColor">#6A7480</Color>
      <Color x:Key="IgAccentColor">#79A6F2</Color>
