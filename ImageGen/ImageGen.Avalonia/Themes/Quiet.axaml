      <SolidColorBrush x:Key="IgAccentBrush" Color="#79A6F2" />
      <SolidColorBrush x:Key="IgOnAccentBrush" Color="#0B1424" />
      <SolidColorBrush x:Key="IgAccentSoftBrush" Color="#1F2D45" />
      <SolidColorBrush x:Key="IgOkBrush" Color="#4CC38A" />
      <SolidColorBrush x:Key="IgErrBrush" Color="#F97066" />
      <SolidColorBrush x:Key="IgErrSoftBrush" Color="#3A1F1E" />
      <SolidColorBrush x:Key="IgWarnBrush" Color="#E8B34B" />
