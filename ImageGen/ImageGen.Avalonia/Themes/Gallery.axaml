<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Gallery: section 2.2 and 2.4 of docs/design/implementation.md. Generated from docs/design/tokens.json. -->
  <CornerRadius x:Key="IgRadiusSm">12</CornerRadius>
  <CornerRadius x:Key="IgRadiusMd">18</CornerRadius>
  <CornerRadius x:Key="IgRadiusLg">24</CornerRadius>
  <CornerRadius x:Key="IgRadiusControl">999</CornerRadius>
  <x:Double x:Key="IgCardGap">16</x:Double>
  <x:Double x:Key="IgFontSizeBody">15</x:Double>
  <FontFamily x:Key="IgFontText">avares://ImageGen.Avalonia/Assets/Fonts#Onest</FontFamily>
  <FontFamily x:Key="IgFontMeta">avares://ImageGen.Avalonia/Assets/Fonts#Onest</FontFamily>
  <Thickness x:Key="IgUserMessagePadding">14,10</Thickness>
  <CornerRadius x:Key="IgUserMessageCornerRadius">18,18,6,18</CornerRadius>
  <HorizontalAlignment x:Key="IgUserMessageAlignment">Right</HorizontalAlignment>
  <x:Boolean x:Key="IgUserMessageRoleVisible">False</x:Boolean>
  <FontFamily x:Key="IgRoleFont">avares://ImageGen.Avalonia/Assets/Fonts#Onest</FontFamily>
  <Thickness x:Key="IgRunBorderThickness">0</Thickness>
  <Thickness x:Key="IgRunPadding">0</Thickness>
  <Thickness x:Key="IgPromptPadding">10,8</Thickness>
  <FontStyle x:Key="IgPromptFontStyle">Normal</FontStyle>
  <FontFamily x:Key="IgPromptFont">avares://ImageGen.Avalonia/Assets/Fonts#Onest</FontFamily>
  <Thickness x:Key="IgCardBorderThickness">0</Thickness>
  <CornerRadius x:Key="IgCardImageCornerRadius">18</CornerRadius>
  <x:Boolean x:Key="IgCardShowFullMeta">False</x:Boolean>
  <x:Boolean x:Key="IgCardShowShortMeta">True</x:Boolean>
  <x:Boolean x:Key="IgCardShowOverlay">True</x:Boolean>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
