      <SolidColorBrush x:Key="IgControlBrush" Color="#6E6B7E" />
      <SolidColorBrush x:Key="IgAccentBrush" Color="#A29DFF" />
      <SolidColorBrush x:Key="IgOnAccentBrush" Color="#14123A" />
      <SolidColorBrush x:Key="IgAccentSoftBrush" Color="#2A2850" />
      <SolidColorBrush x:Key="IgOkBrush" Color="#4CC38A" />
      <SolidColorBrush x:Key="IgErrBrush" Color="#F97066" />
      <SolidColorBrush x:Key="IgErrSoftBrush" Color="#381E22" />
      <SolidColorBrush x:Key="IgWarnBrush" Color="#E3B341" />
      <SolidColorBrush x:Key="IgWarnSoftBrush" Color="#352B17" />
      <SolidColorBrush x:Key="IgPlaceholderBrush" Color="#26252F" />
      <SolidColorBrush x:Key="IgUserMessageBackgroundBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="IgPromptBackgroundBrush" Color="#111017" />
