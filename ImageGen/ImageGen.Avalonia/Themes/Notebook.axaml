<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Notebook: section 2.2 and 2.4 of docs/design/implementation.md. Generated from docs/design/tokens.json. -->
  <CornerRadius x:Key="IgRadiusSm">3</CornerRadius>
  <CornerRadius x:Key="IgRadiusMd">4</CornerRadius>
  <CornerRadius x:Key="IgRadiusLg">6</CornerRadius>
  <CornerRadius x:Key="IgRadiusControl">3</CornerRadius>
  <x:Double x:Key="IgCardGap">10</x:Double>
  <x:Double x:Key="IgFontSizeBody">14</x:Double>
  <FontFamily x:Key="IgFontText">avares://ImageGen.Avalonia/Assets/Fonts#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="IgFontMeta">avares://ImageGen.Avalonia/Assets/Fonts#IBM Plex Mono</FontFamily>
  <Thickness x:Key="IgUserMessagePadding">0</Thickness>
  <CornerRadius x:Key="IgUserMessageCornerRadius">0</CornerRadius>
  <HorizontalAlignment x:Key="IgUserMessageAlignment">Left</HorizontalAlignment>
  <x:Boolean x:Key="IgUserMessageRoleVisible">True</x:Boolean>
  <FontFamily x:Key="IgRoleFont">avares://ImageGen.Avalonia/Assets/Fonts#IBM Plex Mono</FontFamily>
  <Thickness x:Key="IgRunBorderThickness">1</Thickness>
  <Thickness x:Key="IgRunPadding">12</Thickness>
  <Thickness x:Key="IgPromptPadding">10,8</Thickness>
  <FontStyle x:Key="IgPromptFontStyle">Normal</FontStyle>
  <FontFamily x:Key="IgPromptFont">avares://ImageGen.Avalonia/Assets/Fonts#IBM Plex Mono</FontFamily>
  <Thickness x:Key="IgCardBorderThickness">1</Thickness>
  <CornerRadius x:Key="IgCardImageCornerRadius">0</CornerRadius>
  <x:Boolean x:Key="IgCardShowFullMeta">True</x:Boolean>
  <x:Boolean x:Key="IgCardShowShortMeta">False</x:Boolean>
  <x:Boolean x:Key="IgCardShowOverlay">False</x:Boolean>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="IgBgColor">#F5F5F8</Color>
      <Color x:Key="IgSurfaceColor">#FFFFFF</Color>
      <Color x:Key="IgSunkenColor">#ECEBF1</Color>
      <Color x:Key="IgFgColor">#1D1B26</Color>
      <Color x:Key="IgMutedColor">#5F5C6B</Color>
      <Color x:Key="IgLineColor">#D9D7E1</Color>
      <Color x:Key="IgControlColor">#827E91</Color>
      <Color x:Key="IgAccentColor">#4F46E5</Color>
      <Color x:Key="IgOnAccentColor">#FFFFFF</Color>
      <Color x:Key="IgAccentSoftColor">#E7E6FC</Color>
      <Color x:Key="IgOkColor">#17784D</Color>
      <Color x:Key="IgErrColor">#B42318</Color>
      <Color x:Key="IgErrSoftColor">#FBEAE8</Color>
      <Color x:Key="IgWarnColor">#8A5A00</Color>
      <Color x:Key="IgWarnSoftColor">#F8EFD9</Color>
      <Color x:Key="IgPlaceholderColor">#E8E7EE</Color>
      <SolidColorBrush x:Key="IgBgBrush" Color="#F5F5F8" />
      <SolidColorBrush x:Key="IgSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="IgSunkenBrush" Color="#ECEBF1" />
      <SolidColorBrush x:Key="IgFgBrush" Color="#1D1B26" />
      <SolidColorBrush x:Key="IgMutedBrush" Color="#5F5C6B" />
      <SolidColorBrush x:Key="IgLineBrush" Color="#D9D7E1" />
      <SolidColorBrush x:Key="IgControlBrush" Color="#827E91" />
      <SolidColorBrush x:Key="IgAccentBrush" Color="#4F46E5" />
      <SolidColorBrush x:Key="IgOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="IgAccentSoftBrush" Color="#E7E6FC" />
      <SolidColorBrush x:Key="IgOkBrush" Color="#17784D" />
      <SolidColorBrush x:Key="IgErrBrush" Color="#B42318" />
      <SolidColorBrush x:Key="IgErrSoftBrush" Color="#FBEAE8" />
      <SolidColorBrush x:Key="IgWarnBrush" Color="#8A5A00" />
      <SolidColorBrush x:Key="IgWarnSoftBrush" Color="#F8EFD9" />
      <SolidColorBrush x:Key="IgPlaceholderBrush" Color="#E8E7EE" />
      <SolidColorBrush x:Key="IgUserMessageBackgroundBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="IgPromptBackgroundBrush" Color="#ECEBF1" />
      <SolidColorBrush x:Key="IgPromptForegroundBrush" Color="#1D1B26" />
      <SolidColorBrush x:Key="IgCardBackgroundBrush" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="IgBgColor">#15141B</Color>
      <Color x:Key="IgSurfaceColor">#1D1C25</Color>
      <Color x:Key="IgSunkenColor">#111017</Color>
      <Color x:Key="IgFgColor">#E8E6F0</Color>
      <Color x:Key="IgMutedColor">#A3A0B2</Color>
      <Color x:Key="IgLineColor">#302E3B</Color>
      <Color x:Key="IgControlColor">#6E6B7E</Color>
      <Color x:Key="IgAccentColor">#A29DFF</Color>
      <Color x:Key="IgOnAccentColor">#14123A</Color>
