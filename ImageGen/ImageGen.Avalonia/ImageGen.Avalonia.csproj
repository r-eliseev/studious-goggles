<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ImageGen.Avalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64'">false</VlcWindowsArm64Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">true</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Tmds.DBus" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Condition="$([MSBuild]::IsOSPlatform('OSX')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\Licenses\**" />
    <AvaloniaResource Include="Assets\appicon.png" />
    <InternalsVisibleTo Include="ImageGen.Avalonia.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ImageGen.Core/ImageGen.Core.csproj" />
    <ProjectReference Include="../ImageGen.Data/ImageGen.Data.csproj" />
    <ProjectReference Include="../ImageGen.Presentation/ImageGen.Presentation.csproj" />
  </ItemGroup>
</Project>
