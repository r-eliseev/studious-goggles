<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:ImageGen.Avalonia.Markup"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels;assembly=ImageGen.Presentation"
             xmlns:glyphs="clr-namespace:ImageGen.Presentation.Appearance;assembly=ImageGen.Presentation"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="ImageGen.Avalonia.Views.SessionModelsView"
             x:DataType="pm:SessionModelsPageModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Classes="icon" VerticalAlignment="Center" Text="{x:Static glyphs:IconGlyphs.Search}" />
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{markup:Res ModelsSearchPlaceholder}"
                     AutomationProperties.Name="{markup:Res ModelsSearchPlaceholder}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="muted" Text="{Binding RunsPerModelText}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding RunsPerModel, Mode=TwoWay}"
                           Minimum="{Binding MinRunsPerModel}"
                           Maximum="{Binding MaxRunsPerModel}"
                           Increment="1"
                           FormatString="0"
                           AutomationProperties.Name="{Binding RunsPerModelText}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{Binding SelectedCountText}" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="ghost small"
                    Content="{markup:Res Refresh}"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{markup:Res Refresh}" />
        </Grid>

        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     AutomationProperties.Name="{markup:Res ModelsTitle}" />

        <ScrollViewer Grid.Row="4">
            <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="pm:ModelOptionViewModel" x:DataType="pm:ModelOptionViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,2"
                                      AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Classes="meta" Text="{Binding DetailsText}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>

                <TextBlock Classes="section" Text="{markup:Res AssistantModelTitle}" Margin="0,12,0,0" />
                <ItemsControl ItemsSource="{Binding AssistantModels}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="pm:AssistantModelOptionViewModel" x:DataType="pm:AssistantModelOptionViewModel">
                            <RadioButton GroupName="assistant"
                                         IsChecked="{Binding IsSelected}"
                                         Command="{Binding SelectCommand}"
                                         Margin="0,2"
                                         AutomationProperties.Name="{Binding AutomationName}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" />
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.DataTemplates>
                                                <DataTemplate DataType="sys:String" x:DataType="sys:String">
                                                    <Border Classes="tag">
                                                        <TextBlock Classes="meta" Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Classes="meta" Text="{Binding DetailsText}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid x:Name="ButtonRow" Grid.Row="5" Columns="2">
            <Button x:Name="SaveButton"
                    Classes="primary"
                    Content="{markup:Res Save}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="{markup:Res Save}" />
            <Button x:Name="CancelButton"
                    Content="{markup:Res Cancel}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="{markup:Res Cancel}" />
        </UniformGrid>
    </Grid>
</UserControl>
