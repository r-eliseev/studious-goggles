<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:ImageGen.Avalonia.Markup"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels;assembly=ImageGen.Presentation"
             xmlns:conv="clr-namespace:ImageGen.Avalonia.Converters"
             x:Class="ImageGen.Avalonia.Views.ChatView"
             x:DataType="pm:ChatPageModel">
    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmap" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding ModelsButtonText}"
                    Command="{Binding OpenModelsCommand}"
                    MinHeight="44"
                    AutomationProperties.Name="{Binding ModelsButtonText}" />
            <Button Content="{markup:Res ChatParametersButton}"
                    Command="{Binding OpenParametersCommand}"
                    MinHeight="44"
                    AutomationProperties.Name="{markup:Res ChatParametersButton}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Name="Transcript">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="pm:MessageItemViewModel" x:DataType="pm:MessageItemViewModel">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding RoleText}" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       Classes.error="{Binding IsError}" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="pm:RunItemViewModel" x:DataType="pm:RunItemViewModel">
                        <StackPanel Spacing="8" Margin="0,4">
                            <TextBlock Text="{Binding PromptText}" FontStyle="Italic" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Generations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="pm:GenerationItemViewModel" x:DataType="pm:GenerationItemViewModel">
                                        <Border Width="280"
                                                Margin="0,0,8,8"
                                                Padding="8"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                            <StackPanel Spacing="6">
                                                <Image Source="{Binding ImageFilePath, Converter={StaticResource FilePathToBitmap}}"
                                                       IsVisible="{Binding HasImage}"
                                                       Width="264"
                                                       Height="256"
                                                       Stretch="Uniform"
                                                       AutomationProperties.Name="{Binding SummaryText}" />

                                                <ProgressBar IsIndeterminate="True"
                                                             IsVisible="{Binding IsRunning}"
                                                             AutomationProperties.Name="{Binding StatusText}" />

                                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding DetailsText}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ErrorText}"
                                                           IsVisible="{Binding HasErrorText}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Classes.error="{Binding HasError}" />

                                                <WrapPanel>
                                                    <Button Content="{markup:Res Repeat}"
                                                            Command="{Binding RepeatCommand}"
                                                            Margin="0,0,6,6"
                                                            MinHeight="44"
                                                            AutomationProperties.Name="{markup:Res Repeat}" />
                                                    <Button Content="{markup:Res NewSeed}"
                                                            Command="{Binding NewSeedCommand}"
                                                            Margin="0,0,6,6"
                                                            MinHeight="44"
                                                            AutomationProperties.Name="{markup:Res NewSeed}" />
                                                    <Button Content="{markup:Res Edit}"
                                                            Command="{Binding EditCommand}"
                                                            Margin="0,0,6,6"
                                                            MinHeight="44"
                                                            AutomationProperties.Name="{markup:Res Edit}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
            <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{markup:Res AssistantThinking}" />
            <TextBlock Text="{markup:Res AssistantThinking}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{markup:Res AttachImageButton}"
                        Command="{Binding AttachImageCommand}"
                        MinHeight="44"
                        AutomationProperties.Name="{markup:Res AttachImageButton}" />
                <TextBlock Text="{Binding AttachmentsText}" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding PendingAttachments.Count}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="pm:PendingAttachment" x:DataType="pm:PendingAttachment">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                            <Button Content="{markup:Res RemoveAttachment}"
                                    Command="{Binding Remove}"
                                    CommandParameter="{Binding}"
                                    MinHeight="44"
                                    AutomationProperties.Name="{markup:Res RemoveAttachment}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="160"
                         MinHeight="44"
                         PlaceholderText="{markup:Res ChatPlaceholder}"
                         AutomationProperties.Name="{markup:Res ChatPlaceholder}"
                         KeyDown="OnInputKeyDown" />

                <Button Grid.Column="1"
                        Content="{markup:Res Send}"
                        Command="{Binding SendCommand}"
                        VerticalAlignment="Bottom"
                        MinHeight="44"
                        AutomationProperties.Name="{markup:Res Send}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
