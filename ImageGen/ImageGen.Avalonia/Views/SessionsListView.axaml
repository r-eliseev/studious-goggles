<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:ImageGen.Avalonia.Markup"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels;assembly=ImageGen.Presentation"
             xmlns:glyphs="clr-namespace:ImageGen.Presentation.Appearance;assembly=ImageGen.Presentation"
             xmlns:views="clr-namespace:ImageGen.Avalonia.Views"
             x:Class="ImageGen.Avalonia.Views.SessionsListView"
             x:DataType="pm:SessionsPageModel">
    <UserControl.Styles>
        <!-- The delete icon of a row shows while the pointer is over the row. -->
        <Style Selector="Button.row-delete">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.session-row:pointerover Button.row-delete">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <StackPanel Spacing="8">
                <Button Classes="primary"
                        Command="{Binding NewSessionCommand}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{markup:Res NewSession}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="{x:Static glyphs:IconGlyphs.Plus}" />
                        <TextBlock Text="{markup:Res NewSession}" />
                    </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="{markup:Res SearchSessions}"
                             AutomationProperties.Name="{markup:Res SearchSessions}" />
                    <Button Grid.Column="1"
                            Classes="ghost icon"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearchActive}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{markup:Res ClearSearch}">
                        <TextBlock Classes="icon" Text="{x:Static glyphs:IconGlyphs.Close}" />
                    </Button>
                </Grid>
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         AutomationProperties.Name="{markup:Res SessionsTitle}" />

            <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsSearchActive}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section" Text="{markup:Res SessionsToday}" Margin="4,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Today}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pm:SessionItemViewModel">
                                <Grid Classes="session-row" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{markup:Res Rename}"
                                                      Command="{Binding RenameCommand}" />
                                            <MenuItem Header="{markup:Res DeleteSession}"
                                                      Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Button Classes="ghost"
                                            Command="{Binding OpenCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="meta" Text="{Binding DetailsText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="ghost icon row-delete"
                                            Command="{Binding DeleteCommand}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{markup:Res DeleteSession}">
                                        <TextBlock Classes="icon" Text="{x:Static glyphs:IconGlyphs.Delete}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="section" Text="{markup:Res SessionsEarlier}" Margin="4,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Earlier}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pm:SessionItemViewModel">
                                <Grid Classes="session-row" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{markup:Res Rename}"
                                                      Command="{Binding RenameCommand}" />
                                            <MenuItem Header="{markup:Res DeleteSession}"
                                                      Command="{Binding DeleteCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Button Classes="ghost"
                                            Command="{Binding OpenCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="meta" Text="{Binding DetailsText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Classes="ghost icon row-delete"
                                            Command="{Binding DeleteCommand}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{markup:Res DeleteSession}">
                                        <TextBlock Classes="icon" Text="{x:Static glyphs:IconGlyphs.Delete}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Narrow layout: with no sessions the examples take the place of the empty-state panel (task 078). -->
                    <views:StarterExamples IsVisible="{Binding ShowsListExamples}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Row="2" IsVisible="{Binding IsSearchActive}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="meta"
                               Text="{markup:Res NothingFound}"
                               IsVisible="{Binding HasNoResults}"
                               Margin="4,8,0,0" />
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pm:SessionItemViewModel">
                                <Button Classes="ghost"
                                        Command="{Binding OpenCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="meta" Text="{Binding SearchLine}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Classes="ghost icon"
                    Command="{Binding OpenSettingsCommand}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{markup:Res SettingsTitle}">
                <TextBlock Classes="icon" Text="{x:Static glyphs:IconGlyphs.Settings}" />
            </Button>
        </Grid>
</UserControl>
