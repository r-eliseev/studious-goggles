<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:ImageGen.Avalonia.Markup"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels;assembly=ImageGen.Presentation"
             xmlns:views="clr-namespace:ImageGen.Avalonia.Views"
             x:Class="ImageGen.Avalonia.Views.SessionsView"
             x:DataType="pm:SessionsPageModel">

    <Grid x:Name="Layout" ColumnDefinitions="272,*" ColumnSpacing="16" Margin="16">
        <views:SessionsListView Grid.Column="0" />

        <!-- Shown only in the wide layout (SessionsView.axaml.cs). -->
        <Border x:Name="EmptyState" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="12" MaxWidth="440">
                <TextBlock Classes="heading" Text="{markup:Res EmptyChatTitle}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{markup:Res EmptyChatHint}" TextAlignment="Center" TextWrapping="Wrap" />
                <Button Classes="primary"
                        Command="{Binding NewSessionCommand}"
                        HorizontalAlignment="Center"
                        Content="{markup:Res NewSession}"
                        AutomationProperties.Name="{markup:Res NewSession}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
