<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markup="clr-namespace:ImageGen.Avalonia.Markup"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels;assembly=ImageGen.Presentation"
             x:Class="ImageGen.Avalonia.Views.StarterExamples"
             x:DataType="pm:SessionsPageModel">
    <!-- Three starter prompts (task 078). Each button creates a session and sends its text; the data context is the sessions page model. -->
    <StackPanel Spacing="6">
        <Button Classes="ghost"
                Command="{Binding StartExampleCommand}"
                CommandParameter="{Binding Examples[0]}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{Binding Examples[0]}">
            <TextBlock Text="{Binding Examples[0]}" TextWrapping="Wrap" />
        </Button>
        <Button Classes="ghost"
                Command="{Binding StartExampleCommand}"
                CommandParameter="{Binding Examples[1]}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{Binding Examples[1]}">
            <TextBlock Text="{Binding Examples[1]}" TextWrapping="Wrap" />
        </Button>
        <Button Classes="ghost"
                Command="{Binding StartExampleCommand}"
                CommandParameter="{Binding Examples[2]}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="{Binding Examples[2]}">
            <TextBlock Text="{Binding Examples[2]}" TextWrapping="Wrap" />
        </Button>
    </StackPanel>
</UserControl>
