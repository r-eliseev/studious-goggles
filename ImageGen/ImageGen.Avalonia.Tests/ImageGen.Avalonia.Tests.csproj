<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Avalonia.Headless.XUnit 12.1.4 is built against xunit.v3 3.x (extensibility API); xunit.v3 4.x fails at discovery. See the task comments. -->
    <PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ImageGen.Avalonia/ImageGen.Avalonia.csproj" />
  </ItemGroup>
</Project>
