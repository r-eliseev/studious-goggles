<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels"
             xmlns:pmui="clr-namespace:ImageGen.Maui.PageModels"
             xmlns:strings="clr-namespace:ImageGen.Presentation.Resources.Strings"
             xmlns:converters="clr-namespace:ImageGen.Maui.Converters"
             x:Class="ImageGen.Maui.Pages.ChatPage"
             x:DataType="pm:ChatPageModel"
             Title="{Binding Title}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSource" />

            <pmui:ChatItemTemplateSelector x:Key="ChatItemSelector">
                <pmui:ChatItemTemplateSelector.MessageTemplate>
                    <DataTemplate x:DataType="pm:MessageItemViewModel">
                        <VerticalStackLayout Spacing="2" Padding="0,4" SemanticProperties.Description="{Binding Text}">
                            <Label Text="{Binding RoleText}" FontAttributes="Bold" FontSize="12" />
                            <Label Text="{Binding Text}" LineBreakMode="WordWrap">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </DataTemplate>
                </pmui:ChatItemTemplateSelector.MessageTemplate>

                <pmui:ChatItemTemplateSelector.RunTemplate>
                    <DataTemplate x:DataType="pm:RunItemViewModel">
                        <VerticalStackLayout Spacing="8" Padding="0,4" SemanticProperties.Description="{Binding PromptText}">
                            <Label Text="{Binding PromptText}" FontAttributes="Italic" LineBreakMode="WordWrap" />
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                                        BindableLayout.ItemsSource="{Binding Generations}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="pm:GenerationItemViewModel">
                                        <Border WidthRequest="280" Margin="0,0,8,8" Padding="8"
                                                StrokeShape="RoundRectangle 8"
                                                SemanticProperties.Description="{Binding SummaryText}">
                                            <VerticalStackLayout Spacing="6">
                                                <Image Source="{Binding ImageFilePath, Converter={StaticResource FilePathToImageSource}}"
                                                       IsVisible="{Binding HasImage}"
                                                       WidthRequest="264"
                                                       HeightRequest="256"
                                                       Aspect="AspectFit"
                                                       AutomationProperties.IsInAccessibleTree="False" />

                                                <ActivityIndicator IsRunning="{Binding IsRunning}"
                                                                   IsVisible="{Binding IsRunning}"
                                                                   HorizontalOptions="Start"
                                                                   AutomationProperties.IsInAccessibleTree="False" />

                                                <Label Text="{Binding StatusText}" FontAttributes="Bold" FontSize="13" />
                                                <Label Text="{Binding DetailsText}" FontSize="12" LineBreakMode="WordWrap" />
                                                <Label Text="{Binding ErrorText}"
                                                       IsVisible="{Binding HasErrorText}"
                                                       FontSize="12"
                                                       LineBreakMode="WordWrap">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>

                                                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                                                    <Button Text="{x:Static strings:AppResources.Repeat}"
                                                            Command="{Binding RepeatCommand}"
                                                            Margin="0,0,6,6"
                                                            SemanticProperties.Description="{x:Static strings:AppResources.Repeat}" />
                                                    <Button Text="{x:Static strings:AppResources.NewSeed}"
                                                            Command="{Binding NewSeedCommand}"
                                                            Margin="0,0,6,6"
                                                            SemanticProperties.Description="{x:Static strings:AppResources.NewSeed}" />
                                                    <Button Text="{x:Static strings:AppResources.Edit}"
                                                            Command="{Binding EditCommand}"
                                                            Margin="0,0,6,6"
                                                            SemanticProperties.Description="{x:Static strings:AppResources.Edit}" />
                                                    <Button Text="{x:Static strings:AppResources.DescribeButton}"
                                                            Command="{Binding DescribeCommand}"
                                                            Margin="0,0,6,6"
                                                            SemanticProperties.Description="{x:Static strings:AppResources.DescribeButton}" />
                                                    <Button Text="{x:Static strings:AppResources.DescribePromptButton}"
                                                            Command="{Binding DescribePromptCommand}"
                                                            Margin="0,0,6,6"
                                                            SemanticProperties.Description="{x:Static strings:AppResources.DescribePromptButton}" />
                                                </FlexLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </pmui:ChatItemTemplateSelector.RunTemplate>
            </pmui:ChatItemTemplateSelector>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
            <Button Text="{Binding ModelsButtonText}"
                    Command="{Binding OpenModelsCommand}"
                    SemanticProperties.Description="{Binding ModelsButtonText}" />
            <Button Text="{x:Static strings:AppResources.ChatParametersButton}"
                    Command="{Binding OpenParametersCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.ChatParametersButton}" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource ChatItemSelector}"
                        SelectionMode="None" />

        <HorizontalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               AutomationProperties.IsInAccessibleTree="False" />
            <Label Text="{x:Static strings:AppResources.AssistantThinking}" VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <HorizontalStackLayout Spacing="8">
                <Button Text="{x:Static strings:AppResources.AttachImageButton}"
                        Command="{Binding AttachImageCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.AttachImageButton}" />
                <Label Text="{Binding AttachmentsText}" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding PendingAttachments}"
                            IsVisible="{Binding PendingAttachments.Count}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="pm:PendingAttachment">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding FileName}" VerticalTextAlignment="Center" />
                            <Button Text="{x:Static strings:AppResources.RemoveAttachment}"
                                    Command="{Binding Remove}"
                                    CommandParameter="{Binding}"
                                    SemanticProperties.Description="{x:Static strings:AppResources.RemoveAttachment}" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Editor Text="{Binding InputText}"
                        Placeholder="{x:Static strings:AppResources.ChatPlaceholder}"
                        AutoSize="TextChanges"
                        MaximumHeightRequest="160"
                        SemanticProperties.Description="{x:Static strings:AppResources.ChatPlaceholder}" />

                <Button Grid.Column="1"
                        Text="{x:Static strings:AppResources.Send}"
                        Command="{Binding SendCommand}"
                        VerticalOptions="End"
                        SemanticProperties.Description="{x:Static strings:AppResources.Send}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
