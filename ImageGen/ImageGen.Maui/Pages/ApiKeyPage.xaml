<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels"
             xmlns:strings="clr-namespace:ImageGen.Presentation.Resources.Strings"
             xmlns:appearance="clr-namespace:ImageGen.Presentation.Appearance"
             x:Class="ImageGen.Maui.Pages.ApiKeyPage"
             x:DataType="pm:ApiKeyPageModel"
             SafeAreaEdges="All"
             Title="{Binding ProviderTitle}">
    <ScrollView>
        <Border StyleClass="card"
                Margin="16"
                Padding="28"
                MaximumWidthRequest="440"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label StyleClass="heading" Text="{Binding ProviderTitle}" LineBreakMode="WordWrap" />
                <Label StyleClass="muted" Text="{Binding ProviderDescription}" LineBreakMode="WordWrap" />

                <Entry Text="{Binding ApiKey}"
                       Placeholder="{x:Static strings:AppResources.ProviderKeyPlaceholder}"
                       IsPassword="True"
                       SemanticProperties.Description="{Binding ProviderTitle}"
                       SemanticProperties.Hint="{Binding ProviderDescription}" />

                <Button StyleClass="primary"
                        Text="{x:Static strings:AppResources.ApiKeySave}"
                        Command="{Binding SaveCommand}"
                        HorizontalOptions="Fill"
                        SemanticProperties.Description="{x:Static strings:AppResources.ApiKeySave}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   SemanticProperties.Description="{x:Static strings:AppResources.ApiKeyChecking}" />

                <Border IsVisible="{Binding HasPersistenceWarning}"
                        BackgroundColor="{DynamicResource IgWarnSoftColor}"
                        Padding="10"
                        StrokeThickness="0">
                    <HorizontalStackLayout Spacing="8">
                        <Label StyleClass="icon" TextColor="{DynamicResource IgWarnColor}" Text="{x:Static appearance:IconGlyphs.Info}" VerticalTextAlignment="Center" />
                        <Label Text="{Binding PersistenceWarning}" LineBreakMode="WordWrap" />
                    </HorizontalStackLayout>
                </Border>

                <Label Text="{Binding StatusText}" LineBreakMode="WordWrap">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource IgErrColor}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
