<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels"
             xmlns:strings="clr-namespace:ImageGen.Presentation.Resources.Strings"
             xmlns:appearance="clr-namespace:ImageGen.Presentation.Appearance"
             xmlns:controls="clr-namespace:ImageGen.Maui.Controls"
             x:Class="ImageGen.Maui.Pages.SessionsPage"
             x:DataType="pm:SessionsPageModel"
             Title="{x:Static strings:AppResources.SessionsTitle}">
    <Grid x:Name="SessionsLayout" ColumnDefinitions="272,*" ColumnSpacing="16" Padding="16">
        <controls:SessionsListView Grid.Column="0" x:Name="SessionList" />

        <!-- Shown only in the wide layout (SessionsPage.xaml.cs). -->
        <Border x:Name="EmptyState" Grid.Column="1" StyleClass="card" VerticalOptions="Center" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="440">
                <Label StyleClass="heading" Text="{x:Static strings:AppResources.EmptyChatTitle}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Label StyleClass="muted" Text="{x:Static strings:AppResources.EmptyChatHint}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                <Button StyleClass="primary"
                        Command="{Binding NewSessionCommand}"
                        HorizontalOptions="Center"
                        Text="{x:Static strings:AppResources.NewSession}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
