<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels"
             xmlns:strings="clr-namespace:ImageGen.Presentation.Resources.Strings"
             x:Class="ImageGen.Maui.Pages.SessionParametersPage"
             x:DataType="pm:SessionParametersPageModel"
             SafeAreaEdges="All"
             Title="{x:Static strings:AppResources.SessionParametersTitle}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="8">
        <Label StyleClass="muted" Text="{x:Static strings:AppResources.SessionParametersDescription}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}" />

                <Label StyleClass="section" Text="{x:Static strings:AppResources.ParameterAspectRatio}" />
                <Picker ItemsSource="{Binding AspectRatioOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedAspectRatio, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.ParameterAspectRatio}" />

                <Label StyleClass="section" Text="{x:Static strings:AppResources.ParameterResolution}" />
                <Picker ItemsSource="{Binding ResolutionOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.ParameterResolution}" />

                <Label StyleClass="section" Text="{x:Static strings:AppResources.ParameterOutputFormat}" />
                <Picker ItemsSource="{Binding OutputFormatOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.ParameterOutputFormat}" />

                <Label StyleClass="section" Text="{x:Static strings:AppResources.ParameterQuality}" />
                <Picker ItemsSource="{Binding QualityOptions}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.ParameterQuality}" />

                <Label StyleClass="section" Text="{x:Static strings:AppResources.VideoModelsTitle}" />
                <Label StyleClass="meta" Text="{x:Static strings:AppResources.VideoDuration}" />
                <Picker ItemsSource="{Binding VideoDurationOptions}" ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedVideoDuration, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.VideoDuration}" />
                <Label StyleClass="meta" Text="{x:Static strings:AppResources.VideoResolution}" />
                <Picker ItemsSource="{Binding VideoResolutionOptions}" ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedVideoResolution, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.VideoResolution}" />
                <Label StyleClass="meta" Text="{x:Static strings:AppResources.VideoAspectRatio}" />
                <Picker ItemsSource="{Binding VideoAspectRatioOptions}" ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedVideoAspectRatio, Mode=TwoWay}"
                        SemanticProperties.Description="{x:Static strings:AppResources.VideoAspectRatio}" />
                <Switch IsToggled="{Binding GenerateVideoAudio, Mode=TwoWay}"
                        IsVisible="{Binding IsVideoAudioOptionVisible}"
                        SemanticProperties.Description="{x:Static strings:AppResources.VideoGenerateAudio}" />
                <Label StyleClass="meta" Text="{x:Static strings:AppResources.VideoGenerateAudio}"
                       IsVisible="{Binding IsVideoAudioOptionVisible}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="ButtonRow" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="SaveButton"
                    StyleClass="primary"
                    Text="{x:Static strings:AppResources.ParameterSave}"
                    Command="{Binding SaveCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.ParameterSave}" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Text="{x:Static strings:AppResources.Cancel}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.Cancel}" />
        </Grid>
    </Grid>
</ContentPage>
