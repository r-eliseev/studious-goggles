<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <!--
    Base styles on the Ig* resources (docs/design/implementation.md, task 064). Colours, radii and fonts come from the
    theme dictionary (Themes/*.xaml, swapped at runtime). The control height is per platform: StaticResource, because
    it is an OnPlatform value in Themes/Common.xaml (merged first in App.xaml).
  -->

  <Style TargetType="Page" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgBgColor}" />
  </Style>

  <Style TargetType="Shell" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgSunkenColor}" />
    <Setter Property="ForegroundColor" Value="{DynamicResource IgFgColor}" />
    <Setter Property="TitleColor" Value="{DynamicResource IgFgColor}" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="{DynamicResource IgFontText}" />
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeBody}" />
    <Setter Property="TextColor" Value="{DynamicResource IgFgColor}" />
  </Style>

  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{DynamicResource IgFgColor}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource IgPlaceholderColor}" />
    <Setter Property="MinimumHeightRequest" Value="{StaticResource IgControlHeight}" />
  </Style>

  <Style TargetType="Editor">
    <Setter Property="TextColor" Value="{DynamicResource IgFgColor}" />
    <Setter Property="PlaceholderColor" Value="{DynamicResource IgPlaceholderColor}" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgSurfaceColor}" />
    <Setter Property="TextColor" Value="{DynamicResource IgFgColor}" />
    <Setter Property="BorderColor" Value="{DynamicResource IgControlColor}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource IgButtonCornerRadius}" />
    <Setter Property="MinimumHeightRequest" Value="{StaticResource IgControlHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource IgFontText}" />
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeBody}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{DynamicResource IgSunkenColor}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{DynamicResource IgAccentSoftColor}" />
              <Setter Property="BorderColor" Value="{DynamicResource IgAccentColor}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Property="BorderColor" Value="{DynamicResource IgAccentColor}" />
              <Setter Property="BorderWidth" Value="2" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.45" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style TargetType="Button" Class="primary">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgAccentColor}" />
    <Setter Property="BorderColor" Value="{DynamicResource IgAccentColor}" />
    <Setter Property="TextColor" Value="{DynamicResource IgOnAccentColor}" />
  </Style>

  <Style TargetType="Button" Class="ghost">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="BorderColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
  </Style>

  <Style TargetType="Button" Class="danger">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgErrColor}" />
    <Setter Property="BorderColor" Value="{DynamicResource IgErrColor}" />
    <Setter Property="TextColor" Value="{DynamicResource IgSurfaceColor}" />
  </Style>

  <Style TargetType="Button" Class="icon">
    <Setter Property="WidthRequest" Value="{StaticResource IgControlHeight}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="Button" Class="small">
    <Setter Property="MinimumHeightRequest" Value="28" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style TargetType="Label" Class="muted">
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
  </Style>

  <Style TargetType="Label" Class="meta">
    <Setter Property="FontFamily" Value="{DynamicResource IgFontMeta}" />
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeMeta}" />
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
  </Style>

  <Style TargetType="Label" Class="caption">
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeCaption}" />
  </Style>

  <Style TargetType="Label" Class="title">
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeTitle}" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>

  <Style TargetType="Label" Class="heading">
    <Setter Property="FontSize" Value="{DynamicResource IgFontSizeHeading}" />
    <Setter Property="FontAttributes" Value="Bold" />
  </Style>

  <Style TargetType="Label" Class="section">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
    <Setter Property="CharacterSpacing" Value="0.6" />
  </Style>

  <Style TargetType="Label" Class="icon">
    <Setter Property="FontFamily" Value="LucideIcons" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style TargetType="Label" Class="error">
    <Setter Property="TextColor" Value="{DynamicResource IgErrColor}" />
  </Style>

  <Style TargetType="Label" Class="status-done">
    <Setter Property="TextColor" Value="{DynamicResource IgOkColor}" />
  </Style>

  <Style TargetType="Label" Class="status-running">
    <Setter Property="TextColor" Value="{DynamicResource IgAccentColor}" />
  </Style>

  <Style TargetType="Label" Class="status-queued">
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
  </Style>

  <Style TargetType="Label" Class="status-failed">
    <Setter Property="TextColor" Value="{DynamicResource IgErrColor}" />
  </Style>

  <Style TargetType="Label" Class="status-filtered">
    <Setter Property="TextColor" Value="{DynamicResource IgWarnColor}" />
  </Style>

  <Style TargetType="Label" Class="status-cancelled">
    <Setter Property="TextColor" Value="{DynamicResource IgMutedColor}" />
  </Style>

  <Style TargetType="Border" Class="chip">
    <Setter Property="Stroke" Value="{DynamicResource IgControlColor}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="HeightRequest" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="{DynamicResource IgRadiusControl}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Border" Class="tag">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgSunkenColor}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="{DynamicResource IgRadiusControl}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Border" Class="card">
    <Setter Property="BackgroundColor" Value="{DynamicResource IgSurfaceColor}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="{DynamicResource IgRadiusMd}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Border" Class="status">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="StrokeShape">
      <Setter.Value>
        <RoundRectangle CornerRadius="{DynamicResource IgRadiusControl}" />
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
