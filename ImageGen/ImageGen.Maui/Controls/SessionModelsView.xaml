<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ImageGen.Presentation.PageModels"
             xmlns:strings="clr-namespace:ImageGen.Presentation.Resources.Strings"
             x:Class="ImageGen.Maui.Controls.SessionModelsView"
             x:DataType="pm:SessionModelsPageModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="{x:Static strings:AppResources.ModelsSearchPlaceholder}"
                       SemanticProperties.Description="{x:Static strings:AppResources.ModelsSearchPlaceholder}" />
            <Button Grid.Column="1"
                    StyleClass="ghost"
                    FontSize="12"
                    Text="{x:Static strings:AppResources.Refresh}"
                    Command="{Binding RefreshCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.Refresh}" />
        </Grid>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,2">
            <Button Grid.Column="0"
                    StyleClass="ghost"
                    Text="{x:Static strings:AppResources.ImageModelsTab}"
                    Command="{Binding ShowImageModelsCommand}"
                    SemanticProperties.Description="{Binding ImageModelsTabAutomationName}" />
            <Button Grid.Column="1"
                    StyleClass="ghost"
                    Text="{x:Static strings:AppResources.AssistantModelTitle}"
                    Command="{Binding ShowAssistantModelCommand}"
                    SemanticProperties.Description="{Binding AssistantTabAutomationName}" />
            <Button Grid.Column="2"
                    StyleClass="ghost"
                    Text="{x:Static strings:AppResources.VideoModelsTitle}"
                    Command="{Binding ShowVideoModelsCommand}"
                    SemanticProperties.Description="{Binding VideoModelsTabAutomationName}" />
            <Button Grid.Column="3"
                    StyleClass="ghost"
                    Text="{x:Static strings:AppResources.AudioModelsTitle}"
                    Command="{Binding ShowAudioModelsCommand}"
                    SemanticProperties.Description="{Binding AudioModelsTabAutomationName}" />
            <BoxView Grid.Row="1"
                     Grid.Column="0"
                     Color="{DynamicResource IgAccentColor}"
                     IsVisible="{Binding IsImageModelsTabSelected}" />
            <BoxView Grid.Row="1"
                     Grid.Column="1"
                     Color="{DynamicResource IgAccentColor}"
                     IsVisible="{Binding IsAssistantTabSelected}" />
            <BoxView Grid.Row="1" Grid.Column="2" Color="{DynamicResource IgAccentColor}"
                     IsVisible="{Binding IsVideoModelsTabSelected}" />
            <BoxView Grid.Row="1" Grid.Column="3" Color="{DynamicResource IgAccentColor}"
                     IsVisible="{Binding IsAudioModelsTabSelected}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsImageModelsTabSelected}">
                <HorizontalStackLayout Spacing="12">
                    <Label StyleClass="muted" Text="{Binding RunsPerModelText}" VerticalOptions="Center" />
                    <Stepper Value="{Binding RunsPerModel, Mode=TwoWay}"
                             Minimum="{Binding MinRunsPerModel}"
                             Maximum="{Binding MaxRunsPerModel}"
                             Increment="1"
                             SemanticProperties.Description="{Binding RunsPerModelText}" />
                </HorizontalStackLayout>
                <Label Grid.Row="1" StyleClass="section" Text="{Binding SelectedCountText}" VerticalOptions="Center" />
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ImageModelGroups}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pm:ImageModelGroupViewModel">
                                <VerticalStackLayout Spacing="2">
                                    <Button StyleClass="ghost"
                                            HorizontalOptions="Fill"
                                            Text="{Binding HeaderText}"
                                            Command="{Binding ToggleCommand}"
                                            SemanticProperties.Description="{Binding AutomationName}">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="LucideIcons"
                                                             Glyph="{Binding ChevronGlyph}"
                                                             Color="{DynamicResource IgFgColor}"
                                                             Size="16" />
                                        </Button.ImageSource>
                                    </Button>
                                    <VerticalStackLayout Spacing="4"
                                                         IsVisible="{Binding IsExpanded}"
                                                         BindableLayout.ItemsSource="{Binding Rows}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="pm:ModelOptionViewModel">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              SemanticProperties.Description="{Binding AccessibilityName}" />
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" />
                                                        <Label StyleClass="meta" Text="{Binding ProviderText}" />
                                                        <Label StyleClass="meta" Text="{Binding DetailsText}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <ScrollView IsVisible="{Binding IsAssistantTabSelected}">
                <VerticalStackLayout Spacing="4" RadioButtonGroup.GroupName="sessionAssistant" BindableLayout.ItemsSource="{Binding AssistantModelGroups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pm:AssistantModelGroupViewModel">
                            <VerticalStackLayout Spacing="2">
                                <Button StyleClass="ghost"
                                        HorizontalOptions="Fill"
                                        Text="{Binding HeaderText}"
                                        Command="{Binding ToggleCommand}"
                                        SemanticProperties.Description="{Binding AutomationName}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="LucideIcons"
                                                         Glyph="{Binding ChevronGlyph}"
                                                         Color="{DynamicResource IgFgColor}"
                                                         Size="16" />
                                    </Button.ImageSource>
                                </Button>
                                <VerticalStackLayout Spacing="4"
                                                     IsVisible="{Binding IsExpanded}"
                                                     BindableLayout.ItemsSource="{Binding Rows}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="pm:AssistantModelOptionViewModel">
                                            <VerticalStackLayout Spacing="2" Margin="0,4">
                                                <RadioButton Content="{Binding Name}"
                                                             IsChecked="{Binding IsSelected}"
                                                             CheckedChanged="OnAssistantCheckedChanged"
                                                             SemanticProperties.Description="{Binding AutomationName}" />
                                                <Label StyleClass="meta" Text="{Binding ProviderText}" />
                                                <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Tags}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border StyleClass="tag">
                                                                <Label StyleClass="meta" Text="{Binding .}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                                <Label StyleClass="meta" Text="{Binding DetailsText}" />
                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsVideoModelsTabSelected}">
                <Label StyleClass="section" Text="{Binding SelectedVideoCountText}" />
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding VideoModels}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="pm:VideoModelOptionViewModel">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              SemanticProperties.Description="{Binding Name}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" />
                                        <Label StyleClass="meta" Text="{Binding PriceText}" />
                                        <Label StyleClass="meta" Text="{x:Static strings:AppResources.VideoAudioBadge}"
                                               IsVisible="{Binding GeneratesAudio}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsAudioModelsTabSelected}">
                <Label StyleClass="section" Text="{Binding SelectedAudioCountText}" />
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="8">
                        <Label StyleClass="section" Text="{x:Static strings:AppResources.AudioMusicSoundGroup}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding MusicSoundModels}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pm:AudioModelOptionViewModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  SemanticProperties.Description="{Binding Name}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" />
                                            <Label StyleClass="meta" Text="{Binding PriceText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label StyleClass="section" Text="{x:Static strings:AppResources.AudioSpeechGroup}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding SpeechModels}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pm:AudioModelOptionViewModel">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  SemanticProperties.Description="{Binding Name}" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" />
                                            <Label StyleClass="meta" Text="{Binding PriceText}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <Grid x:Name="ButtonRow" Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="SaveButton"
                    StyleClass="primary"
                    Text="{x:Static strings:AppResources.Save}"
                    Command="{Binding SaveCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.Save}" />
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Text="{x:Static strings:AppResources.Cancel}"
                    Command="{Binding CancelCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.Cancel}" />
        </Grid>
    </Grid>
</ContentView>
